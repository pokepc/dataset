{
  "name": "@pokepc/editor",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "pnpm -w build:lib && react-router build",
    "dev": "pnpm -w build:lib && POKEPC_DISABLE_MEMORY_CACHE=1 react-router dev --port 3003 --host 127.0.0.1",
    "start": "POKEPC_DISABLE_MEMORY_CACHE=1 react-router-serve ./build/server/index.js",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "test": "pnpm -w build:lib && vitest run",
    "test:coverage": "pnpm -w build:lib && vitest run --coverage",
    "test:e2e": "pnpm build && playwright test",
    "typecheck": "pnpm -w build:lib && react-router typegen && tsc --noEmit"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@fontsource-variable/geist": "^5.3.0",
    "@pokepc/dataset": "workspace:*",
    "@react-router/node": "8.3.1",
    "@react-router/serve": "8.3.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dnd-manager": "^1.2.0",
    "file-router-collector": "^0.9.0",
    "isbot": "^5.2.2",
    "jotai": "^2.20.3",
    "lucide-react": "^1.41.0",
    "nuqs": "^2.10.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router": "8.3.1",
    "tailwind-merge": "^3.6.0",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@react-router/dev": "8.3.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.4.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitest/coverage-v8": "^5.0.0",
    "oxfmt": "^0.66.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "6.0.3",
    "vite": "^8.2.2",
    "vitest": "^5.0.0"
  }
}
