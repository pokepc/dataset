{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "semi": false,
  "printWidth": 100,
  "trailingComma": "all",
  "tabWidth": 2,
  "proseWrap": "always",
  "singleQuote": true,
  "arrowParens": "always",
  "jsxSingleQuote": false,
  "quoteProps": "as-needed",
  "sortTailwindcss": {
    "functions": ["cn", "twMerge", "createTheme"],
    "attributes": ["theme", "class", "className"]
  },
  "sortPackageJson": true,
  "ignorePatterns": [
    ".git/",
    "build/",
    "dist/",
    "dist-pages/",
    "node_modules/",
    "coverage/",
    "*.min.json",
    "pnpm-*.yaml",
    ".pnpm-store/",
    ".pnpm/",
    ".ignore/",
    ".local/",
    "public/",
    "app/generated/",
    "*-index.json",
    "*.min.json",
    "resources/",
    "data/generated/",
    "src/upstreams/"
  ]
}
