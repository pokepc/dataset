{
  "name": "@pokepc/dataset",
  "version": "6.3.0",
  "files": [
    "build",
    "data"
  ],
  "license": "MIT",
  "type": "module",
  "exports": {
    "./data/*": "./data/*.json",
    "./lib/*": {
      "types": "./build/lib/*.d.mts",
      "import": "./build/lib/*.mjs",
      "default": "./build/lib/*.mjs"
    }
  },
  "scripts": {
    "build": "tsdown",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check",
    "lint": "publint && pnpm typecheck",
    "test": "vitest --run --bail 20",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "yolodb": "^1.2.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/bun": "^1.3.14",
    "@types/node": "^25.9.1",
    "openai": "^6.39.1",
    "oxfmt": "^0.52.0",
    "publint": "^0.3.21",
    "tsdown": "^0.22.1",
    "typescript": "^6.0.3",
    "vitest": "^4.1.7"
  }
}
