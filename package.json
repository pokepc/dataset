{
  "name": "@pokepc/dataset",
  "version": "7.5.0",
  "homepage": "https://pokepc.github.io/dataset",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/pokepc/dataset.git"
  },
  "files": [
    "build",
    "data",
    "LICENSE",
    "README.md",
    "docs"
  ],
  "type": "module",
  "exports": {
    "./data/*.md": "./data/*.md",
    "./data/*": "./data/*.json",
    "./lib/*": {
      "types": "./build/lib/*.d.mts",
      "import": "./build/lib/*.mjs",
      "default": "./build/lib/*.mjs"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "dev": "concurrently --kill-others --names editor,openapi \"pnpm dev:editor\" \"pnpm dev:openapi\"",
    "backlog": "backlog",
    "backlog:browser": "backlog browser --no-open",
    "backlog:ready": "backlog task list --status \"To Do\" --unassigned --ready --plain",
    "build": "pnpm build:lib && pnpm format",
    "build:openapi": "node src/openapi/build.ts",
    "build:pages": "node src/openapi/build.ts",
    "build:pages:versions": "node src/pages/build.ts",
    "generate:pokemon-prose": "bun src/upstream-adapters/pokeapi/generate-pokemon-prose.ts",
    "pokemon:availability": "node src/upstream-adapters/bulbapedia/cli.ts",
    "pokemon:availability:all": "node src/upstream-adapters/bulbapedia/review-cli.ts",
    "locations:import": "bun src/upstream-adapters/locations/cli.ts",
    "codes:sync": "bun src/scripts/sync-codes.ts",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check",
    "lint": "publint && pnpm typecheck",
    "test": "vitest --run --bail 20",
    "test:e2e": "node tests/smoke-tests/pkg-smoke-test-run.ts",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "pnpm build",
    "dev:openapi": "node src/openapi/dev.ts",
    "dev:pages:versions": "node src/openapi/dev.ts --versions",
    "dev:editor": "pnpm --filter @pokepc/editor dev",
    "build:lib": "tsdown",
    "build:editor": "pnpm --filter @pokepc/editor build",
    "typecheck:editor": "pnpm --filter @pokepc/editor typecheck",
    "test:editor": "pnpm --filter @pokepc/editor test",
    "test:e2e:editor": "pnpm --filter @pokepc/editor test:e2e",
    "champions:update": "bun src/upstream-adapters/projectpokemon-champout/update.ts"
  },
  "dependencies": {
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@pokepc/dataset-released": "npm:@pokepc/dataset@7.5.0",
    "@types/bun": "^1.4.2",
    "@types/node": "^26.6.3",
    "cheerio": "^1.2.0",
    "concurrently": "^10.0.5",
    "openai": "^7.25.0",
    "oxfmt": "^0.71.0",
    "publint": "^0.3.24",
    "transliteration": "^2.6.1",
    "tsdown": "^0.23.0",
    "typescript": "^6.0.3",
    "vitest": "^5.0.2",
    "zod-openapi": "^6.0.2"
  },
  "packageManager": "pnpm@12.5.1"
}
