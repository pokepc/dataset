{
  "name": "@pokepc/dataset",
  "private": true,
  "files": [
    "lib",
    "data",
    "!lib/**/*.test.ts"
  ],
  "type": "module",
  "exports": {
    "./lib/constants": "./lib/constants.ts",
    "./lib/enums": "./lib/enums.ts",
    "./lib/fs": "./lib/fs.ts",
    "./lib/languages": "./lib/languages.ts",
    "./lib/schemas": "./lib/schemas.ts",
    "./lib/search": "./lib/search.ts",
    "./lib/types": "./lib/types.ts",
    "./lib/utils": "./lib/utils.ts",
    "./lib/validators": "./lib/validators.ts"
  },
  "scripts": {
    "dev": "PORT=4011 bun run 'viewer/**/*.html'",
    "test": "vitest --run --bail 20",
    "format": "oxfmt --write . && pnpm format:data",
    "format:data": "pnpm format:json ./data --write && pnpm format:json ./data-v7 --write",
    "format:data-check": "pnpm format:json ./data --check && pnpm format:json ./data-v7 --check",
    "format:check": "oxfmt --check && pnpm format:data-check",
    "format:json": "bun run scripts/format-json-dir.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "yolodb": "^1.2.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/bun": "^1.3.12",
    "@types/node": "^25.6.0",
    "clsx": "^2.1.1",
    "openai": "^6.34.0",
    "oxfmt": "^0.45.0",
    "preact": "^10.29.1",
    "typescript": "^6.0.3",
    "vitest": "^4.1.4"
  }
}
